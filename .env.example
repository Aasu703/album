# Copy this to `.env` and fill in real values.
#   cp .env.example .env
# A single root `.env` serves two purposes with plain `docker compose up` (no flags,
# no --env-file needed — this is Compose's built-in default):
#   1. `env_file:` injects it into the backend/app containers (JWT, Cloudinary, OAuth, SMTP).
#   2. Compose itself reads it to resolve ${VAR} substitutions used directly in
#      docker-compose.yml (MONGO_ROOT_USER/PASSWORD, FRONTEND_ORIGIN, APP_DOMAIN,
#      NEXT_PUBLIC_API_URL). MONGO_ROOT_USER/PASSWORD are required — if this file is
#      missing or those are blank, `docker compose up` refuses to start rather than
#      silently booting Mongo without authentication.

# --- Core ---
NODE_ENV=production
# Overridden by compose (with the credentials below) for the backend.
MONGODB_URI=mongodb://mongo:27017/painting_marketplace

# --- MongoDB root credentials (used by the `mongo` service and the backend's
# MONGODB_URI override in docker-compose.yml — mongo is not reachable from the
# host at all, so these only need to be strong, not memorable) ---
# Avoid @ : / ? # % in the password — it's embedded unescaped into a mongodb:// URI
# in docker-compose.yml, and those characters break URI parsing (e.g. an `@` gets
# read as the user@host separator, causing ECONNREFUSED on a bogus host). Stick to
# alphanumerics, e.g.: openssl rand -hex 24
MONGO_ROOT_USER=replace_with_a_root_username
MONGO_ROOT_PASSWORD=replace_with_a_long_random_alphanumeric_password

# --- JWT (use long, random, distinct strings — at least 32 chars each) ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_32_chars
JWT_ACCESS_TTL=15d
JWT_REFRESH_TTL=30d

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- CORS / cookies ---
# The browser origin of the frontend. Behind the bundled Traefik it's http://localhost.
FRONTEND_ORIGIN=http://localhost
COOKIE_SAMESITE=lax

# --- Google OAuth (optional; leave defaults if unused) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- SMTP (optional; blank = password-reset codes logged to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Album <no-reply@album.test>

# --- Frontend build-time (browser API base URL) ---
# Consumed as a compose build-arg for the `app` image, not runtime env.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
